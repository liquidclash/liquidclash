{
  "version": "0.0.5",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": true,
    "longDescription": "Tono",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/Country.mmdb",
      "resources/geoip.dat",
      "resources/geosite.dat",
      "resources/enableLoopback.exe",
      "resources/tono-service.exe",
      "resources/tono-service-install.exe",
      "resources/tono-service-uninstall.exe"
    ],
    "publisher": "Raydocs",
    "externalBin": [
      "sidecar/verge-mihomo"
    ],
    "copyright": "GNU General Public License v3.0",
    "category": "DeveloperTool",
    "shortDescription": "Tono",
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run web:dev",
    "devUrl": "http://localhost:3000/",
    "removeUnusedCommands": true
  },
  "productName": "Tono",
  "mainBinaryName": "Tono",
  "identifier": "com.raydocs.tono",
  "app": {
    "security": {
      "capabilities": [
        "desktop-capability",
        "migrated"
      ],
      "assetProtocol": {
        "enable": false,
        "scope": {
          "allow": [],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  }
}